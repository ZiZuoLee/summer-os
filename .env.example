# Application identity. Use one of: local, test, preview, staging, production.
APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase browser-safe values. Obtain local values from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-or-hosted-publishable-key
# New Supabase projects may label the same browser-safe value as a publishable
# key. If used, replace the ANON line above with:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Server-only. Never prefix these with NEXT_PUBLIC_ and never expose them in logs.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
# New Supabase projects may provide SUPABASE_SECRET_KEY instead. Configure only
# the key type issued by the project and keep it server-only.
# SUPABASE_SECRET_KEY=replace-with-server-only-secret-key

# Cloudflare Turnstile. Use Cloudflare's published test pair for local/CI.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-server-only-turnstile-secret

# Public beta controls.
BETA_SIGNUP_LIMIT=100

# Local synthetic/demo behavior must stay off in hosted environments.
NEXT_PUBLIC_DEMO_MODE=false

# Operational database URLs and age identities do not belong in the app's
# .env.local or Vercel environment. Store SUPABASE_PRODUCTION_DB_URL and
# BACKUP_AGE_RECIPIENT as GitHub Actions secrets only; keep the age private
# identity offline.
